  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
