{
  "name": "dynamic-highlights-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:public": "node --import tsx scripts/evals/audit-public-release.ts",
    "probe:exa": "node scripts/probe-exa.mjs",
    "test": "vitest run",
    "eval:import-simpleqa": "node --import tsx scripts/evals/import-simpleqa.ts",
    "eval:prepare": "node --import tsx scripts/evals/prepare-single-turn-datasets.ts",
    "eval:sweep:dry": "node --import tsx scripts/evals/run-single-turn-sweep.ts",
    "eval:sweep": "node --env-file=.env --import tsx scripts/evals/run-single-turn-sweep.ts --live",
    "eval:sweep:summarize": "node --import tsx scripts/evals/summarize-single-turn-sweep.ts",
    "eval:microscope:export": "node --import tsx scripts/evals/export-microscope-data.ts",
    "eval:agentic:prepare": "node --import tsx scripts/evals/prepare-agentic-datasets.ts",
    "eval:agentic:dry": "node --import tsx scripts/evals/run-agentic-pilot.ts",
    "eval:agentic:one": "node --env-file=.env --import tsx scripts/evals/run-agentic-pilot.ts --live",
    "eval:agentic:grade-dsqa": "node --env-file=.env --import tsx scripts/evals/grade-dsqa-run.ts",
    "eval:agentic:grade-saved": "node --env-file=.env --import tsx scripts/evals/grade-agentic-saved.ts",
    "eval:agentic:batch:dry": "node --import tsx scripts/evals/run-agentic-batch.ts",
    "eval:agentic:batch": "node --env-file=.env --import tsx scripts/evals/run-agentic-batch.ts --live",
    "eval:agentic:summarize": "node --import tsx scripts/evals/summarize-agentic.ts",
    "eval:retrieval:dry": "node --import tsx scripts/evals/run-retrieval-pilot.ts",
    "eval:retrieval:one": "node --env-file=.env --import tsx scripts/evals/run-retrieval-pilot.ts --live",
    "eval:answer:one": "node --env-file=.env --import tsx scripts/evals/answer-pilot-pair.ts",
    "eval:grade:one": "node --env-file=.env --import tsx scripts/evals/grade-pilot-pair.ts",
    "eval:pilot": "node --env-file=.env --import tsx scripts/evals/run-simpleqa-pilot.ts",
    "eval:summarize": "node --import tsx scripts/evals/summarize-simpleqa-pilot.ts",
    "eval:audit": "node --import tsx scripts/evals/audit-retrieval-pair.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "js-tiktoken": "^1.0.21",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
